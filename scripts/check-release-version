#!/usr/bin/env python3
"""Check local version agreement; never publish the unreleased scaffold."""

import json
from pathlib import Path
import re
import sys
import tomllib

root = Path(__file__).resolve().parents[1]
version = tomllib.loads((root / "Cargo.toml").read_text())["package"]["version"]
adapter = tomllib.loads((root / "pyproject.toml").read_text())["project"]["version"]
manifest = json.loads((root / "custom_components/filevault/manifest.json").read_text())["version"]
app = re.search(r'^version: "([^"]+)"$', (root / "filevault/config.yaml").read_text(), re.M).group(1)
if len({version, adapter, manifest, app}) != 1:
    raise SystemExit("Version mismatch")
if len(sys.argv) > 1 and (version == "0.0.0" or sys.argv[1] != "v" + version):
    raise SystemExit("Unreleased scaffold or mismatched tag")
print("Version agreement:", version)
