#!/usr/bin/env python3
"""Package only committed public source; never copy runtime state."""

import argparse
import hashlib
import json
import struct
import subprocess
import sys
import tomllib
from pathlib import Path

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser()
parser.add_argument("--output", type=Path, required=True)
args = parser.parse_args()


def git(*argv: str) -> bytes:
    return subprocess.check_output(["git", *argv], cwd=root)


if git("status", "--porcelain").strip():
    raise SystemExit("Commit and review the candidate before packaging")
version = tomllib.loads(git("show", "HEAD:Cargo.toml").decode())["package"]["version"]
if version == "0.0.0":
    raise SystemExit("Unreleased scaffold version")
commit = git("rev-parse", "HEAD").decode().strip()
for app_path, integration_path, size in [
    ("filevault/icon.png", "custom_components/filevault/brand/icon.png", 256),
    ("filevault/logo.png", "custom_components/filevault/brand/icon@2x.png", 512),
]:
    asset = git("show", "HEAD:" + app_path)
    if asset != git("show", "HEAD:" + integration_path):
        raise SystemExit("App and integration branding must match")
    if asset[:8] != b"\x89PNG\r\n\x1a\n" or struct.unpack(">II", asset[16:24]) != (
        size,
        size,
    ):
        raise SystemExit("Invalid brand PNG dimensions")
for path, size in [
    ("custom_components/filevault/brand/dark_icon.png", 256),
    ("custom_components/filevault/brand/dark_icon@2x.png", 512),
]:
    asset = git("show", "HEAD:" + path)
    if asset[:8] != b"\x89PNG\r\n\x1a\n" or struct.unpack(">II", asset[16:24]) != (
        size,
        size,
    ):
        raise SystemExit("Invalid dark brand PNG dimensions")
output = args.output.resolve()
output.mkdir(parents=True, exist_ok=True)
source = output / f"ha-filevault-{version}.tar.gz"
subprocess.run(
    [
        "git",
        "archive",
        "--format=tar.gz",
        "--prefix=ha-filevault/",
        "--output=" + str(source),
        "HEAD",
    ],
    cwd=root,
    check=True,
)
subprocess.run(
    [sys.executable, str(root / "scripts/build-integration"), "--output", str(output)],
    cwd=root,
    check=True,
)
integration = output / "filevault.zip"
provenance = output / "SOURCE.json"
provenance.write_text(
    json.dumps(
        {
            "repository": "https://github.com/jessfraz/ha-filevault",
            "version": version,
            "commit": commit,
            "status": (
                "manual server identity verification required; "
                "compatibility depends on the Mac and deployed network path"
            ),
        },
        indent=2,
    )
    + "\n"
)
checksums = output / "SHA256SUMS"
checksums.write_text(
    "".join(
        f"{hashlib.sha256(p.read_bytes()).hexdigest()}  {p.name}\n"
        for p in [source, integration, provenance]
    )
)
print(f"Packaged committed public source {commit} for {version}")
