{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error"
      }
    },
    "schemas": {
      "AttemptReport": {
        "properties": {
          "outcome": {
            "type": "string"
          }
        },
        "required": [
          "outcome"
        ],
        "type": "object"
      },
      "ChallengeReport": {
        "properties": {
          "expires_in": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "nonce": {
            "type": "string"
          }
        },
        "required": [
          "expires_in",
          "nonce"
        ],
        "type": "object"
      },
      "CheckError": {
        "enum": [
          "dns_failed",
          "dns_timed_out",
          "invalid_address",
          "tcp_unreachable",
          "tcp_timed_out",
          "ssh_unavailable",
          "ssh_timed_out",
          "interrupted"
        ],
        "type": "string"
      },
      "ConnectionHistoryReport": {
        "properties": {
          "connection": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConnectionSummary"
              }
            ],
            "nullable": true
          },
          "last_success": {
            "$ref": "#/components/schemas/EndpointSuccesses"
          },
          "latest": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConnectionRun"
              }
            ],
            "description": "Latest observation for this profile, independent of pagination.",
            "nullable": true
          },
          "next": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ConnectionRun"
            },
            "type": "array"
          },
          "retention_days": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "retention_runs": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "stale": {
            "description": "Missing, unfinished, or older than ten minutes means unknown now.",
            "type": "boolean"
          }
        },
        "required": [
          "last_success",
          "results",
          "retention_days",
          "retention_runs",
          "stale"
        ],
        "type": "object"
      },
      "ConnectionRun": {
        "properties": {
          "finished_at": {
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "lan": {
            "$ref": "#/components/schemas/EndpointObservation"
          },
          "sequence": {
            "format": "int64",
            "type": "integer"
          },
          "started_at": {
            "format": "int64",
            "type": "integer"
          },
          "state": {
            "$ref": "#/components/schemas/RunState"
          },
          "tailscale": {
            "$ref": "#/components/schemas/EndpointObservation"
          }
        },
        "required": [
          "lan",
          "sequence",
          "started_at",
          "state",
          "tailscale"
        ],
        "type": "object"
      },
      "ConnectionSummary": {
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "format": "uint16",
            "minimum": 0,
            "type": "integer"
          },
          "tailscale_host": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "host",
          "port",
          "tailscale_host",
          "username"
        ],
        "type": "object"
      },
      "ConnectivityReport": {
        "properties": {
          "lan": {
            "$ref": "#/components/schemas/EndpointCheck"
          },
          "nameservers": {
            "description": "IPs only, never search domains or the complete resolver configuration.",
            "items": {
              "format": "ip",
              "type": "string"
            },
            "type": "array"
          },
          "run": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConnectionRun"
              }
            ],
            "nullable": true
          },
          "tailscale": {
            "$ref": "#/components/schemas/EndpointCheck"
          }
        },
        "required": [
          "lan",
          "nameservers",
          "tailscale"
        ],
        "type": "object"
      },
      "Decision": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "unlock_available": {
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "unlock_available"
        ],
        "type": "object"
      },
      "DnsCheck": {
        "enum": [
          "not_checked",
          "not_configured",
          "resolved",
          "failed",
          "timed_out",
          "rejected"
        ],
        "type": "string"
      },
      "EndpointCheck": {
        "properties": {
          "dns": {
            "$ref": "#/components/schemas/DnsCheck"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "format": "uint16",
            "minimum": 0,
            "type": "integer"
          },
          "ssh": {
            "$ref": "#/components/schemas/SshCheck"
          },
          "tcp": {
            "$ref": "#/components/schemas/TcpCheck"
          }
        },
        "required": [
          "dns",
          "host",
          "port",
          "ssh",
          "tcp"
        ],
        "type": "object"
      },
      "EndpointObservation": {
        "additionalProperties": false,
        "properties": {
          "dns": {
            "$ref": "#/components/schemas/DnsCheck"
          },
          "error": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CheckError"
              }
            ],
            "description": "A fixed category only. Never an OS, DNS, SSH or authentication message.",
            "nullable": true
          },
          "ssh": {
            "$ref": "#/components/schemas/SshCheck"
          },
          "tcp": {
            "$ref": "#/components/schemas/TcpCheck"
          }
        },
        "required": [
          "dns",
          "ssh",
          "tcp"
        ],
        "type": "object"
      },
      "EndpointSuccesses": {
        "properties": {
          "lan": {
            "$ref": "#/components/schemas/LastSuccess"
          },
          "tailscale": {
            "$ref": "#/components/schemas/LastSuccess"
          }
        },
        "required": [
          "lan",
          "tailscale"
        ],
        "type": "object"
      },
      "Error": {
        "description": "Error information from a response.",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ],
        "type": "object"
      },
      "LastSuccess": {
        "properties": {
          "reachable_at": {
            "description": "An SSH handshake succeeded, including identities awaiting confirmation.",
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "verified_at": {
            "description": "The observed server identity matched the existing trust store.",
            "format": "int64",
            "nullable": true,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ManualChallengeReport": {
        "properties": {
          "expires_in": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "nonce": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/ManualTarget"
          }
        },
        "required": [
          "expires_in",
          "nonce",
          "target"
        ],
        "type": "object"
      },
      "ManualTarget": {
        "properties": {
          "host": {
            "type": "string"
          },
          "host_key_fingerprint": {
            "type": "string"
          },
          "port": {
            "format": "uint16",
            "minimum": 0,
            "type": "integer"
          },
          "trust_status": {
            "type": "string"
          },
          "trusted": {
            "type": "boolean"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "host",
          "host_key_fingerprint",
          "port",
          "trust_status",
          "trusted",
          "username"
        ],
        "type": "object"
      },
      "ManualTrustReport": {
        "properties": {
          "trusted": {
            "type": "boolean"
          }
        },
        "required": [
          "trusted"
        ],
        "type": "object"
      },
      "Outcome": {
        "enum": [
          "running",
          "booting",
          "rejected",
          "timed_out",
          "authenticated",
          "unconfirmed"
        ],
        "type": "string"
      },
      "RecoveryActivity": {
        "properties": {
          "active": {
            "type": "boolean"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/RecoveryEvent"
            },
            "type": "array"
          },
          "outcome": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Outcome"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "active",
          "events"
        ],
        "type": "object"
      },
      "RecoveryEvent": {
        "properties": {
          "elapsed_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "elapsed_ms",
          "message"
        ],
        "type": "object"
      },
      "RecoveryStatus": {
        "properties": {
          "activity": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RecoveryActivity"
              }
            ],
            "nullable": true
          },
          "busy": {
            "type": "boolean"
          },
          "retry_after_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "busy",
          "retry_after_ms"
        ],
        "type": "object"
      },
      "RunState": {
        "enum": [
          "checking",
          "complete",
          "interrupted"
        ],
        "type": "string"
      },
      "RuntimeCheck": {
        "enum": [
          "not_configured",
          "verified",
          "identity_needed",
          "unavailable",
          "name_unavailable",
          "timed_out",
          "stale"
        ],
        "type": "string"
      },
      "SshCheck": {
        "enum": [
          "not_checked",
          "trusted",
          "identity_needed",
          "unavailable",
          "timed_out"
        ],
        "type": "string"
      },
      "State": {
        "enum": [
          "running",
          "ssh_reachable",
          "verified_preboot",
          "unreachable",
          "unknown"
        ],
        "type": "string"
      },
      "StatusReport": {
        "properties": {
          "configuration_errors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "configuration_notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "connection": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConnectionSummary"
              }
            ],
            "nullable": true
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "manual_ready": {
            "type": "boolean"
          },
          "runtime_check": {
            "$ref": "#/components/schemas/RuntimeCheck"
          },
          "transport_ready": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "configuration_errors",
          "configuration_notes",
          "decision",
          "manual_ready",
          "runtime_check",
          "transport_ready",
          "version"
        ],
        "type": "object"
      },
      "SystemReport": {
        "properties": {
          "configuration_errors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "configuration_notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "connection": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConnectionSummary"
              }
            ],
            "nullable": true
          },
          "credential_role": {
            "type": "string"
          },
          "manual_ready": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "configuration_errors",
          "configuration_notes",
          "credential_role",
          "manual_ready",
          "version"
        ],
        "type": "object"
      },
      "TcpCheck": {
        "enum": [
          "not_checked",
          "connected",
          "unreachable",
          "timed_out"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "description": "Status suggestions, verified-phase recovery, and explicitly confirmed manual SSH authentication to pinned targets. Authentication does not certify FileVault unlock.",
    "title": "FileVault API",
    "version": "0.1.2"
  },
  "openapi": "3.0.3",
