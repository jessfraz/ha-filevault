{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error"
      }
    },
    "schemas": {
      "AttemptReport": {
        "properties": {
          "outcome": {
            "type": "string"
          }
        },
        "required": [
          "outcome"
        ],
        "type": "object"
      },
      "ChallengeReport": {
        "properties": {
          "expires_in": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "nonce": {
            "type": "string"
          }
        },
        "required": [
          "expires_in",
          "nonce"
        ],
        "type": "object"
      },
      "ConnectionSummary": {
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "format": "uint16",
            "minimum": 0,
            "type": "integer"
          },
          "tailscale_host": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "host",
          "port",
          "tailscale_host",
          "username"
        ],
        "type": "object"
      },
      "Decision": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "unlock_available": {
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "unlock_available"
        ],
        "type": "object"
      },
      "Error": {
        "description": "Error information from a response.",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ],
        "type": "object"
      },
      "ManualChallengeReport": {
        "properties": {
          "expires_in": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "nonce": {
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/ManualTarget"
          }
        },
        "required": [
          "expires_in",
          "nonce",
          "target"
        ],
        "type": "object"
      },
      "ManualTarget": {
        "properties": {
          "host": {
            "type": "string"
          },
          "host_key_fingerprint": {
            "type": "string"
          },
          "port": {
            "format": "uint16",
            "minimum": 0,
            "type": "integer"
          },
          "trust_status": {
            "type": "string"
          },
          "trusted": {
            "type": "boolean"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "host",
          "host_key_fingerprint",
          "port",
          "trust_status",
          "trusted",
          "username"
        ],
        "type": "object"
      },
      "ManualTrustReport": {
        "properties": {
          "trusted": {
            "type": "boolean"
          }
        },
        "required": [
          "trusted"
        ],
        "type": "object"
      },
      "RuntimeCheck": {
        "enum": [
          "not_configured",
          "verified",
          "identity_needed",
          "unavailable",
          "name_unavailable",
          "timed_out",
          "stale"
        ],
        "type": "string"
      },
      "State": {
        "enum": [
          "running",
          "ssh_reachable",
          "verified_preboot",
          "unreachable",
          "unknown"
        ],
        "type": "string"
      },
      "StatusReport": {
        "properties": {
          "configuration_errors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "configuration_notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "connection": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConnectionSummary"
              }
            ],
            "nullable": true
          },
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "manual_ready": {
            "type": "boolean"
          },
          "runtime_check": {
            "$ref": "#/components/schemas/RuntimeCheck"
          },
          "transport_ready": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "configuration_errors",
          "configuration_notes",
          "decision",
          "manual_ready",
          "runtime_check",
          "transport_ready",
          "version"
        ],
        "type": "object"
      },
      "SystemReport": {
        "properties": {
          "configuration_errors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "configuration_notes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "connection": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ConnectionSummary"
              }
            ],
            "nullable": true
          },
          "credential_role": {
            "type": "string"
          },
          "manual_ready": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "configuration_errors",
          "configuration_notes",
          "credential_role",
          "manual_ready",
          "version"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Status suggestions, verified-phase recovery, and explicitly confirmed manual SSH authentication to pinned targets. Authentication does not certify FileVault unlock.",
    "title": "FileVault API",
    "version": "0.1.0-alpha.4"
  },
