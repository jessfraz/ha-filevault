{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error"
      }
    },
    "schemas": {
      "AttemptReport": {
        "properties": {
          "outcome": {
            "type": "string"
          }
        },
        "required": [
          "outcome"
        ],
        "type": "object"
      },
      "ChallengeReport": {
        "properties": {
          "expires_in": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "nonce": {
            "type": "string"
          }
        },
        "required": [
          "expires_in",
          "nonce"
        ],
        "type": "object"
      },
      "Decision": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "unlock_available": {
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "unlock_available"
        ],
        "type": "object"
      },
      "Error": {
        "description": "Error information from a response.",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ],
        "type": "object"
      },
      "State": {
        "enum": [
          "running",
          "verified_preboot",
          "unreachable",
          "unknown"
        ],
        "type": "string"
      },
      "StatusReport": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "transport_ready": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "decision",
          "transport_ready",
          "version"
        ],
        "type": "object"
      },
      "SystemReport": {
        "properties": {
          "credential_role": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "credential_role",
          "version"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Status and bounded ephemeral recovery requests. Real unlock disabled until verified preboot transport is available.",
    "title": "FileVault API",
    "version": "0.1.0-alpha.1"
  },
  "openapi": "3.0.3",
